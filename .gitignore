# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# design sources — the full-resolution masters live here and are far too large
# to track (35 MB for the hero alone). Only the derived assets in public/media
# ship. design/README.md records how to regenerate them from the masters.
/design/*
!/design/README.md

# belt and braces: the hero masters arrive at the repo root before being filed
# into design/hero/. Never let them slip into a commit from there.
/before-hero.png
/after-hero.png
/hero-video.mp4
/coordinator-with-couple.webp
/pharmacy-pickup.webp

# Local agent tooling — skill definitions and their lockfile. Not part of the
# product, and they land in the repo root rather than a config dir, so they get
# swept up by `git add -A` if not ignored.
/.agents/
/.claude/
/skills-lock.json
